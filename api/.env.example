PORT=8787
NODE_ENV=production
# openssl rand -hex 32
SESSION_SECRET=
APP_ORIGIN=https://your-domain.example
PLATFORM_API_URL=https://api.your-domain.example
PLATFORM_SECRET_KEY=sk_...
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/help-me-outgrow
# This api's own public address (Zoho redirect URI = PUBLIC_URL/auth/zoho/callback; payment webhooks)
PUBLIC_URL=https://api.your-domain.example
# Zoho sign-in (optional, beside Google). Register the redirect URI above in the Zoho API console.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Becomes an owner of /admin at first sign-in; owners invite everyone else
ADMIN_OWNER_EMAIL=
# 64 hex chars (openssl rand -hex 32). Journal entries are encrypted with keys derived from it. Never change it.
JOURNAL_KEY=
SUPPORT_EMAIL=support@htsta.com
