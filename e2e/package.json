{
  "name": "help-me-outgrow-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "stack": "node stack.mjs",
    "test": "mkdir -p test-results && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml tests/*.test.mjs",
    "demo": "xvfb-run -a -s \"-screen 0 1280x800x24\" node demo.mjs",
    "demo:r1": "xvfb-run -a -s \"-screen 0 1280x800x24\" node demo-r1.mjs"
  },
  "devDependencies": { "playwright": "^1.50.0" }
}
